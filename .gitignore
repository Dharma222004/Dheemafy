!data/navidrome.db
data/*.db-shm
data/*.db-wal
data/cache/

# Binary executables and external submodules
navidrome.exe
navidrome/

# Logs and temporary scratch scripts
*.log
scratch/

# Operating System Files
.DS_Store
Thumbs.db
