# Normalize all text files to LF on checkin (cross-platform consistency)
* text=auto eol=lf

# Binary files — never convert
*.db binary
*.db-shm binary
*.db-wal binary
*.ico binary
*.png binary
*.jpg binary
*.jpeg binary
*.gif binary
*.webp binary
*.woff binary
*.woff2 binary
*.ttf binary
*.eot binary
*.mp3 binary
*.mp4 binary
*.wav binary
